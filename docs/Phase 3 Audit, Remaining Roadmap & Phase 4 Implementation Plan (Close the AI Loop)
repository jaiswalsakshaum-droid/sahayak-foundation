def deterministic_numeric_check(rule: dict, citizen_profile: dict) -> Optional[dict]:
    """Parses common government requirement phrasings and compares to a real profile field.
    Returns None if it can't confidently parse the requirement — caller falls through to the LLM path."""
    criterion = rule["criterion_name"].strip().lower()
    field_key = KNOWN_NUMERIC_PROFILE_FIELDS.get(criterion)
    if not field_key or field_key not in citizen_profile:
        return None

    requirement = rule["requirement"]
    citizen_value = citizen_profile[field_key]

    # "Below ₹3,50,000" / "Below Rs 350000"
    m = re.search(r"below\s*[₹Rs.]*\s*([\d,]+)", requirement, re.IGNORECASE)
    if m:
        threshold = int(m.group(1).replace(",", ""))
        status = "verified" if citizen_value < threshold else "mismatch"
        return {"status": status, "citizen_info": f"₹{citizen_value:,}", "explanation":
                f"Requirement is below ₹{threshold:,}; citizen's actual value is ₹{citizen_value:,}."}

    # "14-18 years" / "18-25 years" range
    m = re.search(r"(\d+)\s*-\s*(\d+)\s*years?", requirement, re.IGNORECASE)
    if m:
        lo, hi = int(m.group(1)), int(m.group(2))
        status = "verified" if lo <= citizen_value <= hi else "mismatch"
        return {"status": status, "citizen_info": f"{citizen_value} years", "explanation":
                f"Requirement is {lo}-{hi} years; citizen is {citizen_value} years old."}

    return None  # couldn't confidently parse — fall through to LLM judgment, don't guess

def llm_judge_rule(rule: dict, citizen_profile: dict, verified_documents: List[dict]) -> dict:
    """For boolean/enum/text rules, or numeric rules the parser couldn't handle confidently."""
    system_prompt = (
        "You are Sahayak's Eligibility Agent. Judge whether the citizen satisfies ONE specific "
        "scheme criterion, using ONLY the evidence provided — never assume anything not given. "
        "Return JSON: {'status': 'verified'|'missing'|'mismatch', 'citizen_info': 'the evidence value you used, verbatim', "
        "'explanation': 'one sentence citing exactly which piece of evidence you used'}. "
        "If there is no evidence available for this criterion at all, return status 'missing', "
        "not a guess."
    )
    user_prompt = (
        f"Criterion: {rule['criterion_name']}\n"
        f"Requirement: {rule['requirement']}\n"
        f"Rule type: {rule['rule_type']}\n"
        f"Citizen profile: {json.dumps(citizen_profile)}\n"
        f"Verified documents on file: {json.dumps(verified_documents)}"
    )
    result = call_groq_json_with_retry(MODEL_REASONING, system_prompt, user_prompt)
    if not result:
        return {"status": "missing", "citizen_info": "Unable to evaluate", "explanation": "Evaluation service unavailable."}
    return result

def eligibility_agent_node(state: SahayakState) -> Dict[str, Any]:
    run_id, scheme_id = state.get("run_id"), state.get("selected_scheme_id")
    profile = state.get("citizen_profile", {})
    write_agent_event(run_id, "Eligibility Agent", "Evaluating scheme criteria against verified citizen evidence...")

    rules_data = []
    verified_docs = []
    if supabase_admin and scheme_id:
        try:
            rules_data = supabase_admin.table("eligibility_rules").select("*").eq("scheme_id", scheme_id).execute().data or []
            citizen_id = state.get("citizen_id")
            verified_docs = supabase_admin.table("documents").select("document_type,extracted_fields").eq("citizen_id", citizen_id).eq("status", "verified").execute().data or []
        except Exception as e:
            logger.error(f"Error fetching rules/documents for eligibility check: {e}")

    evaluated_criteria = []
    has_missing = False

    for rule in rules_data:
        result = None
        if rule.get("rule_type") == "numeric":
            result = deterministic_numeric_check(rule, profile)
        if result is None:
            result = llm_judge_rule(rule, profile, verified_docs)

        status = result.get("status", "missing")
        if status != "verified":
            has_missing = True

        evaluated_criteria.append({
            "criterion_name": rule["criterion_name"],
            "citizen_info": result.get("citizen_info", ""),
            "requirement": rule["requirement"],
            "evidence_source": rule.get("evidence_source", "Profile"),
            "status": status,
            "explanation": result.get("explanation", ""),
        })

        write_audit_log(run_id, "Eligibility Agent", f"Evaluated rule: {rule['criterion_name']}",
                         evidence=f"Requirement: {rule['requirement']} | Citizen data: {result.get('citizen_info','')}",
                         result=status.upper())

    is_eligible = not has_missing
    eligibility_payload = {
        "is_eligible": is_eligible,
        "criteria": evaluated_criteria,
        "message": "All criteria verified." if is_eligible else "Action needed: one or more criteria unresolved.",
    }

    # Validate before returning — see D.8
    try:
        EligibilityResult(**{"is_eligible": is_eligible, "criteria": evaluated_criteria, "message": eligibility_payload["message"]})
    except Exception as e:
        logger.error(f"eligibility_agent_node produced an invalid payload shape: {e}")

    write_agent_event(run_id, "Eligibility Agent",
                       "Criteria evaluation complete." if is_eligible else "One or more criteria could not be verified.",
                       {"eligibility": eligibility_payload})
    return {"eligibility_result": eligibility_payload}
```
The parser above only needs to cover the ~5 rule phrasings in your seeded demo schemes (see D.4) — it's intentionally not a general-purpose requirement-text parser. Anything it can't confidently match falls through to the LLM, which is the correct default, not a gap.

### D.6 Task Group 4 — Real `document_agent_node`

No LLM call is actually needed for the *matching* logic — this is genuine set arithmetic, and a deterministic answer is more trustworthy here than a model guess:

```python
def document_agent_node(state: SahayakState) -> Dict[str, Any]:
    run_id, scheme_id, citizen_id = state.get("run_id"), state.get("selected_scheme_id"), state.get("citizen_id")
    retry_count = state.get("retry_count", 0)
    write_agent_event(run_id, "Document Agent", "Checking required documents against citizen records...")

    required, on_file_types = [], set()
    if supabase_admin and scheme_id:
        try:
            required = supabase_admin.table("document_requirements").select("*").eq("scheme_id", scheme_id).execute().data or []
            on_file = supabase_admin.table("documents").select("document_type").eq("citizen_id", citizen_id).eq("status", "verified").execute().data or []
            on_file_types = {d["document_type"] for d in on_file}
        except Exception as e:
            logger.error(f"Error fetching document requirements/on-file documents: {e}")

    missing = [r["document_type"] for r in required if r.get("is_mandatory") and r["document_type"] not in on_file_types]
    verified = [r["document_type"] for r in required if r["document_type"] in on_file_types]

    message = (f"{len(missing)} required document(s) missing: {', '.join(missing)}. Upload required to proceed."
               if missing else "All required documents are on file and verified.")
    write_agent_event(run_id, "Document Agent", message, {"missing_documents": missing, "verified_documents": verified})

    next_action = None
    if missing:
        next_action = {"type": "upload_document", "document_name": missing[0],
                        "description": f"Please upload your {missing[0]} to continue application assembly.",
                        "agent": "Document Agent"}

    return {"missing_documents": missing, "next_action": next_action, "retry_count": retry_count + 1}
```
Once this and D.5 both read real data, the existing conditional-edge loop (`eligibility_agent → document_agent → eligibility_agent`, capped at one re-entry) finally does something meaningful: uploading the real enrollment certificate mid-flow lets `document_agent` see it on the second pass, `eligibility_agent` re-evaluate with the new evidence, and the run actually reach `application_agent` — the success path that's currently structurally present but unreachable.

