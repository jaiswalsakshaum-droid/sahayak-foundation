# Supabase Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Groq API Configuration (used for agent text/reasoning tasks)
# NOTE: Groq does NOT provide vision-capable models on the free tier.
# Document vision extraction uses Google Gemini (see below).
GROQ_API_KEY=gsk_your_groq_api_key_here

# Google Gemini Vision (REQUIRED for document image/PDF extraction)
# Get a free key at: https://aistudio.google.com/apikey
# Free tier: 15 requests/min, 1M tokens/day — sufficient for development.
GOOGLE_API_KEY=your_google_ai_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Security
# A long, random, unguessable string shared between this backend and the Supabase Edge Function.
# Generate with: openssl rand -hex 32
# The backend will refuse all /run and /extract-document requests without a matching
# X-Sahayak-Internal-Secret header.
INTERNAL_SHARED_SECRET=

# Model Routing (Groq text models for agent reasoning)
MODEL_FAST=openai/gpt-oss-20b
MODEL_REASONING=openai/gpt-oss-120b
