# Supabase Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Groq API Configuration (get free key from https://console.groq.com/keys)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Security
# A long, random, unguessable string shared between this backend and the frontend's
# server-side calls. Generate a fresh one per deployment (e.g. `openssl rand -hex 32`).
# Never commit the real value. The backend will refuse all /run and /extract-document
# requests without a matching X-Sahayak-Internal-Secret header if this is unset.
INTERNAL_SHARED_SECRET=

# Model Routing
MODEL_FAST=openai/gpt-oss-20b
MODEL_REASONING=openai/gpt-oss-120b
