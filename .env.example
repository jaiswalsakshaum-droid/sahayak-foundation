# Supabase Configuration for Sahayak
# Replace with your real Supabase project URL and Anon Public Key from https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Optional: Supabase Service Role Key (used only in secure server environments or edge functions)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here